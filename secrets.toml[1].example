# Copy this file to secrets.toml (locally) or paste its contents into
# your Streamlit Cloud app's "Secrets" settings.
#
# This is OPTIONAL. If you don't set an access_code, the app runs with
# no login gate at all. Setting one adds a simple shared-password screen
# so the invoice generator isn't wide open on a public URL.
#
# secrets.toml is already in .gitignore -- never commit real secrets.

[auth]
access_code = "change-me"
